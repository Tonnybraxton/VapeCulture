vors.\u003cbr\u003e\u003c\/p\u003e\n\u003cp\u003eBLVK Unicorn – Spearmint Nicotine Salt Features:\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003e30mL Unicorn Bottle\u003c\/li\u003e\n\u003cli\u003e40% PG\u003cstrong\u003e\/\u003c\/strong\u003e60% VG\u003c\/li\u003e\n\u003cli\u003eMade in USA\u003c\/li\u003e\n\u003cli\u003eAvailable in 35mg, 50mg\u003c\/li\u003e\n\u003c\/ul\u003e","brand":"BLVK","offers":[{"title":"35mg","offer_id":41670547111991,"sku":"BLVK - Spearmint 35 mg","price":1650.0,"currency_code":"KES","in_stock":false},{"title":"50mg","offer_id":41670547144759,"sku":"BLVK - Spearmint 50 mg","price":1650.0,"currency_code":"KES","in_stock":false}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/blvk_unicorn_salt_series_salts_spearmint_box_bottle.jpg?v=1747708379"},{"product_id":"blvk-unicorn-nicotine-salt-mango","title":"BLVK Unicorn Nicotine Salt - Mango","description":"\u003cp\u003eMango SALT by BLVK Unicorn is a mentholated nicotine salt creation, pairing a delectable ripe mango with a nice cool menthol blast that will invigorate the senses and taste buds.\u003cbr\u003e\u003c\/p\u003e\n\u003cp\u003eBLVK Unicorn – Mango Nicotine Salt Features:\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003e30mL Unicorn Bottle\u003c\/li\u003e\n\u003cli\u003e40% PG\u003cstrong\u003e\/\u003c\/strong\u003e60% VG\u003c\/li\u003e\n\u003cli\u003eMade in USA\u003c\/li\u003e\n\u003cli\u003eAvailable in 35mg, 50mg\u003c\/li\u003e\n\u003c\/ul\u003e","brand":"BLVK","offers":[{"title":"35mg","offer_id":41670547177527,"sku":"BLVK - Mango 35 mg","price":1650.0,"currency_code":"KES","in_stock":true},{"title":"50mg","offer_id":41670547210295,"sku":"BLVK - Mango 50 mg","price":1650.0,"currency_code":"KES","in_stock":true}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/blvk_unicorn_salt_series_salts_mango_box_bottle.jpg?v=1747708383"},{"product_id":"blvk-unicorn-nicotine-salt-lychee","title":"BLVK Unicorn Nicotine Salt - Lychee","descri