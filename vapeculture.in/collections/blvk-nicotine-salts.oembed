.com\/s\/files\/1\/0599\/6799\/5959\/files\/blvk_unicorn_salt_series_salts_cuban_cigar_box_bottle.jpg?v=1747708390"},{"product_id":"blvk-unicorn-nicotine-salt-caramel-tobacco","title":"BLVK Unicorn Nicotine Salt - Caramel","description":"\u003cp\u003eCaramel Salt by BLVK Unicorn takes rich notes of thick caramel, combining it with the essence of rolled tobacco leaves to create a tasty invigorating vape experience that will leave the taste buds longing for the next vape session.\u003c\/p\u003e\n\u003cp\u003eBLVK Unicorn – Caramel Nicotine Salt Features:\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003e30mL Unicorn Bottle\u003c\/li\u003e\n\u003cli\u003e40% PG\u003cstrong\u003e\/\u003c\/strong\u003e60% VG\u003c\/li\u003e\n\u003cli\u003eMade in USA\u003c\/li\u003e\n\u003cli\u003eAvailable in 35mg, 50mg\u003c\/li\u003e\n\u003c\/ul\u003e","brand":"BLVK","offers":[{"title":"35mg","offer_id":41670547537975,"sku":"BLVK - Caramel 35 mg","price":1650.0,"currency_code":"KES","in_stock":false},{"title":"50mg","offer_id":41670547570743,"sku":"BLVK - Caramel 50 mg","price":1650.0,"currency_code":"KES","in_stock":true}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/blvk-caramel-unicorn-nicotine-salt.webp?v=1756882564"},{"product_id":"blvk-yellow-nic-salt-mango-banana-ice","title":"BLVK \u0026 Yellow Nic Salt - Mango Banana Ice","description":"\u003cp\u003eA tropical escape filled with sweet tropical mangos and fresh, ripe bananas!\u003cbr\u003e\u003cbr\u003e\u003cstrong\u003eWARNING: THIS PRODUCT IS NOT DESIGNED FOR USE THAT REACH SUB-OHM RESISTANCE. IT IS MADE FOR THE USE IN POD DEVICES.\u003c\/strong\u003e\u003cbr\u003e\u003cbr\u003e\u003cstrong\u003eFeatures:\u003c\/strong\u003e\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003eBottle Size – 30 ML\u003c\/li\u003e\n\u003cli\u003eNicotine Level – 35 MG, 50 MG\u003c\/li\u003e\n\u003cli\u003eIngredients – Propylene Glycol, Vegetable Glycerin, Natural \u0026amp; Artificial Flavors, Nicotine.\u003cbr\u003e\n\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cul\u003e\u003c\/ul\u003e","brand":"BLVK","offers":[{"title":"35mg","offer_id":41670547636279,"sku":"BLVK - Mango Banana Ice 35 mg","price":1650.0,"currency_code":"KES","in_stock":false},{"title":"50mg","offer_id":41670547669047,"sku":"BLVK - Mango Banana Ice 50 mg","price":1650.0,"currency_code":"KES","in_stock":false}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/blvk-yellow-nic-salt-mango-banana-ice.jpg?v=1747708397"},{"product_id":"blvk-yellow-nic-salt-mango-grape-apple-ice","title":"BLVK \u0026 Yellow Nic Salt -  Mango Grape Apple Ice","description":"\u003cp\u003eBLVK \u0026amp; Yellow Nic Salt - Fresh mango slices blended with sweet plump grapes and crisp apples.\u003cbr\u003e\u003cbr\u003e\u003cstrong\u003eFeatures:\u003c\/strong\u003e\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003eBottle Size – 30 ML\u003c\/li\u003e\n\u003cli\u003eNicotine Level – 35 MG, 50 MG\u003c\/li\u003e\n\u003cli\u003eIngredients – Propylene Glycol, Vegetable Glycerin, Natural \u0026amp; Artificial Flavors, Nicotine.\u003cbr\u003e\n\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp\u003e\u003cstrong\u003eWARNING: \u003c\/strong\u003eTHIS PRODUCT IS NOT DESIGNED FOR USE THAT REACH SUB-OHM RESISTANCE. IT IS MADE FOR THE USE IN POD DEVICES.\u003c\/p\u003e\n\u003cul\u003e\u003c\/ul\u003e","brand":"BLVK","offers":[{"title":"35mg","offer_id":41670547734583,"sku":"BLVK -  Mango Grape Apple Ice 35 mg","price":1650.0,"currency_code":"KES","in_stock":false},{"title":"50mg","offer_id":41670547767351,"sku":"BLVK -  Mango Grape Apple Ice 50 mg","price":1650.0,"currency_code":"KES","in_stock":true}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/blvk-yellow-mango-green-apple-ice-bottle.jpg?v=1747708400"},{"product_id":"blvk-yellow-nic-salt-mango-passion-ice","title":"BLVK \u0026 Yellow Nic Salt -  Mango Passion Ice","description":"\u003cp\u003eBLVK \u0026amp; Yellow Nic Salt - Taste this exotic blend of juicy mango chunks with a tangy passionfruit kick.\u003cbr\u003e\u003cbr\u003e\u003cstrong\u003eFeatures:\u003c\/strong\u003e\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003eBottle Size – 30 ML\u003c\/li\u003e\n\u003cli\u003eNicotine Level – 35 MG, 50 MG\u003c\/li\u003e\n\u003cli\u003eIngredients – Propylene Glycol, Vegetable Glycerin, Natural \u0026amp; Artificial Flavors, Nicotine.\u003cbr\u003e\n\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp\u003e\u003cstrong\u003eWARNING: \u003c\/strong\u003eTHIS PRODUCT IS NOT DESIGNED FOR USE THAT REACH SUB-OHM RESISTANCE. IT IS MADE FOR THE USE IN POD DEVICES.\u003c\/p\u003e\n\u003cul\u003e\u003c\/ul\u003e","brand":"BLVK","offers":[{"title":"35mg","offer_id":41670547800119,"sku":"BLVK -  Mango Passion Ice 35 mg","price":1650.0,"currency_code":"KES","in_stock":false},{"title":"50mg","offer_id":41670547832887,"sku":"BLVK -  Mango Passion Ice 50 mg","price":1650.0,"currency_code":"KES","in_stock":false}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/blvk-yellow-nic-salt-mango-passion-ice.jpg?v=1747708405"},{"product_id":"blvk-yellow-nic-salt-mango-strawberry-ice","title":"BLVK \u0026 Yellow Nic Salt - Mango Strawberry Ice","description":"\u003cp\u003eBLVK \u0026amp; Yellow Nic Salt - Enjoy a sweet explosion of juicy mangos mixed with your favorite ripe strawberries.\u003cbr\u003e\u003cbr\u003e\u003cstrong\u003eFeatures:\u003c\/strong\u003e\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003eBottle Size – 30 ML\u003c\/li\u003e\n\u003cli\u003eNicotine Level – 35 MG, 50 MG\u003c\/li\u003e\n\u003cli\u003eIngredients – Propylene Glycol, Vegetable Glycerin, Natural \u0026amp; Artificial Flavors, Nicotine.\u003cbr\u003e\n\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp\u003e\u003cstrong\u003eWARNING: \u003c\/strong\u003eTHIS PRODUCT IS NOT DESIGNED FOR USE THAT REACH SUB-OHM RESISTANCE. IT IS MADE FOR THE USE IN POD DEVICES.\u003c\/p\u003e\n\u003cul\u003e\u003c\/ul\u003e","brand":"BLVK","offers":[{"title":"35mg","offer_id":416705