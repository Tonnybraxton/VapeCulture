head change that enhances your smoking experience.\u003c\/p\u003e\n\u003cp\u003e\u003cstrong\u003eSpecification\u003c\/strong\u003e:\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003eBrand Name: FOXYVAPE\u003c\/li\u003e\n\u003cli\u003eLiquid Capacity : 8.0ML Built-in Pod\u003c\/li\u003e\n\u003cli\u003eNicotine by volume: 4.0%\u003c\/li\u003e\n\u003cli style=\"font-style: italic;\"\u003e\n\u003cem\u003e3000 PUFFS\u003c\/em\u003e\u003cbr\u003e\n\u003c\/li\u003e\n\u003cli\u003eBattery Capacity: 1100mAh \u003c\/li\u003e\n\u003c\/ul\u003e","brand":"Foxy","offers":[{"title":"Watermelon Bubble","offer_id":41611961991223,"sku":"Foxy V (3k P) - Watermelon Bubble","price":999.0,"currency_code":"KES","in_stock":false},{"title":"Luch Ice","offer_id":41611962023991,"sku":"Foxy V (3K P) - Lush Ice","price":999.0,"currency_code":"KES","in_stock":false},{"title":"Lolipop","offer_id":41611962056759,"sku":"Foxy V (3K P) - Lolipop","price":999.0,"currency_code":"KES","in_stock":false},{"title":"Menthol","offer_id":41611962089527,"sku":"Foxy V (3K P) - Menthol","price":999.0,"currency_code":"KES","in_stock":false},{"title":"Almond Dessert","offer_id":41611962122295,"sku":"Foxy V (3K P) - Almond Desert","price":999.0,"currency_code":"KES","in_stock":false},{"title":"Blueberry Ice","offer_id":41611962155063,"sku":"Foxy V (3K P) - Blueberry Ice","price":999.0,"currency_code":"KES","in_stock":false},{"title":"Cantaloupe","offer_id":41611962187831,"sku":"Foxy V (3K P) - Cantaloupe","price":999.0,"currency_code":"KES","in_stock":false},{"title":"Pine Colada","offer_id":41611962220599,"sku":"Foxy V (3K P) - Pine Colada","price":999.0,"currency_code":"KES","in_stock":false},{"title":"Orange Lamonade","offer_id":41611962253367,"sku":"Foxy V (3K P) - Orange Lemonade","price":999.0,"currency_code":"KES","in_stock":false},{"title":"Wild Berries","offer_id":41611962286135,"sku":"Foxy V (3K P) - Wild Berries","price":999.0,"currency_code":"KES","in_stock":false},{"title":"Rose Supari","offer_id":4161196