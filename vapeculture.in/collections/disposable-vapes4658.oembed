/0599\/6799\/5959\/files\/elfbar-trio-vape.webp?v=1769610521"},{"product_id":"iget-move-50000-puffs","title":"IGET Move (50000 Puffs)","description":"\u003cp\u003eIGET Move B50000 positions itself at the high end of the \u003ca href=\"https:\/\/[YOUR DOMAIN]\/collections\/disposable-vapes\" title=\"disposable vape\"\u003edisposable vape\u003c\/a\u003e market, offering a massive puff count, a digital display, and—its most unique feature—the ability to switch between two different flavors in a single device. This makes it an appealing option for vapers seeking convenience, longevity, and flavor variety without committing to a single taste profile all day.\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003eDual-Flavor Technology: This is the standout innovation. The IGET Move allows users to toggle between two distinct flavor profiles simply by rotating a section of the device.\u003c\/li\u003e\n\u003cli\u003eDigital Screen Display: A clear digital screen allows users to easily monitor both the remaining battery life and the e-liquid level. \u003c\/li\u003e\n\u003cli\u003eMesh Coil Technology: Equipped with a 0.9O Mesh \u003ca href=\"https:\/\/[YOUR DOMAIN]\/collections\/vape-coils-pods\" title=\"vape coil\"\u003evape Coil\u003c\/a\u003e, the IGET Move delivers excellent vapor quality. \u003c\/li\u003e\n\u003cli\u003eRechargeable Battery: The device includes an 850mAh rechargeable battery, with inclusion of type C port.\u003c\/li\u003e\n\u003c\/ul\u003e","brand":"IGET","offers":[{"title":"Dragon Fruit + Strawberry Banana Dragon Fruit","offer_id":42085555568695,"sku":"I Move (50K P) - Dragon Fruit + Strawberry Banana Dragon Fruit","price":3150.0,"currency_code":"KES","in_stock":false},{"title":"Passion Fruit Mango Ice + Kiwi Passion Fruit Guava","offer_id":42085555666999,"sku":"I Move (50K P) - Passion Fruit Mango Ice + Kiwi Passion Fruit Guava","price":3150.0,"currency_code":"KES","in_stock":true},{"title":"Original Monster + Blue Monster","offer_id":42085555699767,"sku":"I Move (50K P) - Original Monster + Blue Monster","price":3150.0,"currency_code":"KES","in_stock":true},{"title":"Mr Blue + Blueberry Sour Raspberry","offer_id":42085555732535,"sku":"I Move (50K P) - Mr Blue + Blueberry Sour Raspberry","price":3150.0,"currency_code":"KES","in_stock":true},{"title":"Lush Ice + Watermelon Blueberry","offer_id":42085555765303,"sku":"I Move (50K P) - Lush Ice + Watermelon Blueberry","price":3150.0,"currency_code":"KES","in_stock":true},{"title":"Grape Ice + Blackcurrant","offer_id":42085572673591,"sku":"I Move (50K P) - Grape Ice + Blackcurrant","price":3150.0,"currency_code":"KES","in_stock":true},{"title":"Raspberry Ice + Grape Cranberry Blueberry Raspberry","offer_id":42085572739127,"sku":"I Move (50K P) - Raspberry Ice + Grape Cranberry Blueberry Raspberry","price":3150.0,"currency_code":"KES","in_stock":true},{"title":"Lime Monster + Pineapple Monster","offer_id":42085572608055,"sku":"I Move (50K P) - Lime Monster + Pineapple Monster","price":3150.0,"currency_code":"KES","in_stock":true},{"title":"Triple Melon + Melon Pineapple Orange","offer_id":42085572804663,"sku":"I Move (50K P) - Triple Melon + Melon Pineapple Orange","price":3150.0,"currency_code":"KES","in_stock":true},{"title":"Strawberry Kiwi + Watermelon Kiwi","offer_id":42085572837431,"sku":"I Move (50K P) - Strawberry Kiwi + Watermelon Kiwi","price":3150.0,"currency_code":"KES","in_stock":true},{"title":"Strawberry Ice + Strawberry Mango","offer_id":42085572870199,"sku":"I Move (50K P) - Strawberry Ice + Strawberry Mango","price":3150.0,"currency_code":"KES","in_stock":true},{"title":"Strawberry Banana Ice + Strawberry Watermelon Ice","offer_id":42085572902967,"sku":"I Move (50K P) - Strawberry Banana Ice + Strawberry Watermelon Ice","price":3150.0,"currency_code":"KES","in_stock":true},{"title":"Red Bull Ice + Mint Ice","offer_id":42085572706359,"sku":"I Move (50K P) - Red Bull Ice + Mint Ice","price":3150.0,"currency_code":"KES","in_stock":false},{"title":"Pineapple Coc