:false},{"title":"Passion Fruit Kiwi Guava Ice","offer_id":41914903560247,"sku":"B Whale (6K Puffs) - Passion Fruit Kiwi Guava Ice","price":890.0,"currency_code":"KES","in_stock":false},{"title":"Orange Ice","offer_id":41914903593015,"sku":"B Whale (6K Puffs) - Orange Ice","price":890.0,"currency_code":"KES","in_stock":false},{"title":"Strawberry Watermelon","offer_id":41914903625783,"sku":"B Whale (6K Puffs) - Strawberry Watermelon","price":890.0,"currency_code":"KES","in_stock":false},{"title":"Blueberry Raspberry Ice","offer_id":41914903658551,"sku":"B Whale (6K Puffs) - Blueberry Raspberry Ice","price":890.0,"currency_code":"KES","in_stock":false},{"title":"Honey Grapefruit","offer_id":41914903691319,"sku":"B Whale (6K Puffs) - Honey Grapefruit","price":890.0,"currency_code":"KES","in_stock":false},{"title":"Double Apple Ice","offer_id":41914903724087,"sku":"B Whale (6K Puffs) - Double Apple Ice","price":890.0,"currency_code":"KES","in_stock":false},{"title":"Watermelon Passion Fruit Shisha","offer_id":41914903756855,"sku":"B Whale (6K Puffs) - Watermelon Passion Fruit Shisha","price":890.0,"currency_code":"KES","in_stock":false},{"title":"Strawberry Kiwi Ice","offer_id":41916135899191,"sku":"B Whale (6K Puffs) - Strawberry Kiwi Ice","price":890.0,"currency_code":"KES","in_stock":false}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/bou-whale-vape-disposable-15-flavours.jpg?v=1759874309"},{"product_id":"spaceman-sp40000-vape","title":"Spaceman SP40000 Vape (40000 Puffs)","description":"\u003cp\u003eWith its high puff count, wattage range, large capacity, and digital display, the \u003cstrong\u003e\u003cem\u003eSMOK \u003c\/em\u003e\u003c\/strong\u003eSpaceman SP40000 Disposable Vape is beyond impressive. Adjust power from 10W to 26W, control your menthol and nicotine level, and experience a delicious selection of flavors for as many as 40,000 puffs.\u003c\/p\u003e\n\u003cp\u003eThe Spaceman SP40000 \u003ca href=\"https:\/\/[YOUR DOMAIN]\/collections\/disposable-vapes\" title=\"Disposable vape\"\u003eDisposable Vape\u003c\/a\u003e \u003cstrong\u003e\u003cem\u003eby SMOK\u003c\/em\u003e\u003c\/strong\u003e is one of the most innovative devices to hit the market yet. The device is beyond impressive, boasting some of the most stunning features, giving the market a big bang before 2025 ends. \u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003eIntegrated 1000mAh rechargeable battery\u003c\/li\u003e\n\u003cli\u003eRecharges via USB Type-C\u003c\/li\u003e\n\u003cli\u003ePre-filled with 5% (50mg) salt nicotine\u003c\/li\u003e\n\u003cli\u003e40000 puffs vape\u003c\/li\u003e\n\u003cli\u003eWattage control system (10W, 16W, 20W, 26W)\u003c\/li\u003e\n\u003cli\u003eDual mesh coils\u003c\/li\u003e\n\u003cli\u003eDigital screen - displays wattage, ice control \u0026amp; nic level;\u003c\/li\u003e\n\u003cli\u003eE-liquid and battery level indicator on vape\u003c\/li\u003e\n\u003c\/ul\u003e","brand":"SMOK","offers":[{"title":"Peach Mango","offer_id":41973902311479,"sku":"Space SP40K V (40K P) - Peach Mango","price":1700.0,"currency_code":"KES","in_stock":false},{"title":"Triple Berry","offer_id":41973903491127,"sku":"Space SP40K V (40K P) - Triple Berry","price":1700.0,"currency_code":"KES","in_stock":false},{"title":"Grape Ice","offer_id":41973903523895,"sku":"Space SP40K V (40K P) - Grape Ice","price":1700.0,"currency_code":"KES","in_stock":false},{"title":"Blueberry Cherry Cranberry","offer_id":41973903556663,"sku":"Space SP40K V (40K P) - Blueberry Cherry Cranberry","price":1700.0,"currency_code":"KES","in_stock":false},{"title":"Blueberry Raspberry","offer_id":41973903589431,"sku":"Space SP40K V (40K P) - Blueberry Raspberry","price":1700.0,"currency_code":"KES","in_stock":false},{"title":"Pineapple Ice","offer_id":41973903622199,"sku":"Space SP40K V (40K P) - Pineapple Ice","price":1700.0,"currency_code":"KES","in_stock":false},{"title":"Cherry","offer_id":41973903654967,"sku":"Space SP40K V (40K P) - Cherry","price":1700.0,"currency_code":"KES","in_stock":false},{"title":"Blueberry Bubblegum","offer_id":41973903687735,"sku":"Space SP40K V (40K P) - Blueberry Bubblegum","price":1700.0,"currency_code":"KES","in_stock":false},{"title":"Blueberry Pomegranate","offer_id":41973903720503,"sku":"Space SP40K V (40K P) - Blueberry Pomegranate","price":1700.0,"currency_code":"KES","in_stock":false},{"title":"Raspberry White Grape","offer_id":41973903753271,"sku":"Space SP40K V (40K P) - Raspberry White Grape","price":1700.0,"currency_code":"KES","in_stock":false},{"title":"Strawberry Raspberry Cherry Ice","offer_id":41973903786039,"sku":"Space SP40K V (40K P) - Strawberry Raspberry Cherry Ice","price":1700.0,"currency_code":"KES","in_stock":false},{"title":"Blueberry Ice","offer_id":41973903818807,"sku":"Space SP40K V (40K P) - Blueberry Ice","price":1700.0,"currency_code":"KES","in_stock":false}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/spaceman-sp40000-all-flavours.webp?v=1762196103"},{"product_id":"nasty-bolt-50k-vape","title":"Nasty BOLT 50k Vape (50000 Puffs)","description":"\u003cp\u003eThe NASTY BOLT Hyper Puff Vape Device is built for those who crave power, consistency, and flavour that hits hard. It offers three performance modes—ECO, NORMAL, and TURBO— so you can tailor every puff to your vibe. Expect up to 5 days of use on a single charge, and when it’s time to recharge, the fast-charging tech gets you back in action within minutes.\u003c\/p\u003e\n\u003cp\u003eUnder the hood, the dual mesh coil system delivers next-level heating precision and massive vapour production. Every draw is smooth, flavour-packed, and satisfying—exactly how a premium vape should feel. With smart power management ensuring stable output, the NASTY BOLT stands out as the ultimate choice for vapers who demand long-lasting performance, bold taste, and zero compromise.\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003eVolume: 26ml\u003c\/li\u003e\n\u003cli\u003eBattery: 1000mAH\u003c\/li\u003e\n\u003cli\u003ePuff: 50,000\u003c\/li\u003e\n\u003cli\u003eNicotine: 50mg\/mL\u003c\/li\u003e\n\u003cli\u003eDual Mesh Coil\u003c\/li\u003e\n\u003cli\u003eAir Flow Control\u003c\/li\u003e\n\u003cli\u003eExtra Fast - Charging Rechargeable Battery (\u0026lt; 25 mins)\u003c\/li\u003e\n\u003cli\u003eDual Screen With Flavour \u0026amp; Battery Indicator\u003c\/li\u003e\n\u003cli\u003e3 Modes Selection\n\u003cul\u003e\n\u003cli\u003eEco\u003c\/li\u003e\n\u003cli\u003eNormal\u003c\/li\u003e\n\u003cli\u003eTurbo\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003c\/li\u003e\n\u003c\/ul\u003e","brand":"Nasty","offers":[{"title":"Grape Ice","offer_id":41973940092983,"sku":"N BOLT 50K V (50K P) - Grape Ice","price":2600.0,"currency_code":"KES","in_stock":false},{"title":"Berry Grape","offer_id":41973947301943,"sku":"N BOLT 50K V (50K P) - Berry Grape","price":2600.0,"currency_code":"KES","in_stock":false},{"title":"Energy Drink","offer_id":41973947400247,"sku":"N BOLT 50K V (50K P) - Energy Drink","price":2600.0,"currency_code":"KES","in_stock":false},{"title":"Kiwi Passion Fruit Guava","offer_id":41973947433015,"sku":"N BOLT 50K V (50K P) - Kiwi Passion Fruit Guava","price":2600.0,"currency_code":"KES","in_stock":false},{"title":"Mix Berry","offer_id":41973947498551,"sku":"N BOLT 50K V (50K P) - Mix Berry","price":2600.0,"currency_code":"KES","in_stock":false},{"title":"Peach Ice","offer_id":41973947531319,"sku":"N BOLT 50K V (50K P) - Peach Ice","price":2600.0,"currency_code":"KES","in_stock":false},{"title":"Strawberry Ice","offer_id":41973947596855,"sku":"N BOLT 50K V (50K P) - Strawberry Ice","price":2600.0,"currency_code":"KES","in_stock":false},{"title":"Strawberry Kiwi","offer_id":41973947629623,"sku":"N BOLT 50K V (50K P) - Strawberry Kiwi","price":2600.0,"currency_code":"KES","in_stock":false},{"title":"Strawberry Watermelon","offer_id":41973947662391,"sku":"N BOLT 50K V (50K P) - Strawberry Watermelon","price":2600.0,"currency_code":"KES","in_stock":