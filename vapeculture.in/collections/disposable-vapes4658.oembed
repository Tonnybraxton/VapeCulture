id":42016179781687,"sku":"I Soul (40K P) - Blackberry Cherry Pomegranate","price":2599.0,"currency_code":"KES","in_stock":true},{"title":"Jasmine Mint","offer_id":42023570374711,"sku":"I Soul (40K P) - Jasmine Mint","price":2599.0,"currency_code":"KES","in_stock":false}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/iget-soul-blackberry-ice.webp?v=1765233508"},{"product_id":"elfworld-pb45000-45000-puffs","title":"Elfworld PB45000 (45000 Puffs)","description":"\u003cp\u003eMeet the Elfworld PB45000 — a next-gen disposable vape that puts full control in your hands. This innovative device lets you adjust nicotine strength, ice intensity, and airflow, so your vape hits exactly how you want it, every time.\u003c\/p\u003e\n\u003cp\u003eFeatures:\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003e3 Adjustable Nicotine Levels – Switch your strength whenever your mood changes\u003c\/li\u003e\n\u003cli\u003e3 Adjustable Ice Levels – Choose from smooth to ultra-icy\u003c\/li\u003e\n\u003cli\u003eAdjustable Airflow System – Tight MTL draw or airy clouds? You decide\u003c\/li\u003e\n\u003cli\u003eMassive Puff Capacity – Built for long-lasting satisfaction\u003c\/li\u003e\n\u003cli\u003e800mAh Rechargeable Battery – Charge via Type-C and keep going\u003c\/li\u003e\n\u003cli\u003eSmart Digital Display – Always see real-time battery \u0026amp; e-liquid status\u003c\/li\u003e\n\u003c\/ul\u003e","brand":"ELF BAR","offers":[{"title":"Grape Ice","offer_id":42016284049463,"sku":"E W PB45000 (45K P) - Grape Ice","price":2400.0,"currency_code":"KES","in_stock":true},{"title":"Sour Watermelon Drop","offer_id":42016284114999,"sku":"E W PB45000 (45K P) - Sour Watermelon Drop","price":2400.0,"currency_code":"KES","in_stock":true},{"title":"Banana Strawberry","offer_id":42016284180535,"sku":"E W PB45000 (45K P) - Banana Strawberry","price":2400.0,"currency_code":"KES","in_stock":true},{"title":"Kiwi Passion Fruit Guava","offer_id":42016284016695,"sku":"E W PB45000 (45K P) - Kiwi Passion Fruit Guava","price":2400.0,"currency_code":"KES","in_stock":false},{"title":"Cranberry Juice","offer_id":42016284082231,"sku":"E W PB45000 (45K P) - Cranberry Juice","price":2400.0,"currency_code":"KES","in_stock":false},{"title":"Blue Razz Ice","offer_id":42016284147767,"sku":"E W PB45000 (45K P) - Blue Razz Ice","price":2400.0,"currency_code":"KES","in_stock":false},{"title":"Watermelon Frozen","offer_id":42016284213303,"sku":"E W PB45000 (45K P) - Watermelon Frozen","price":2400.0,"currency_code":"KES","in_stock":false},{"title":"Peach Mango","offer_id":42016267960375,"sku":"E W PB45000 (45K P) - Peach Mango","price":2400.0,"currency_code":"KES","in_stock":false}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/elfworld-pb45000-banana-strawberry.webp?v=1765240776"},{"product_id":"adalya-ad40000-40000-puffs","title":"Adalya AD40000 (40000 Puffs)","description":"\u003cp\u003eThe Adalya Aurora 40K is a premium high-tech disposable vape built for a dual mesh coil— giving you full control over vapour density and flavour intensity. It’s the most advanced Adalya disposable ever, delivering a true Turkish shisha-style experience in a compact all-in-one device.\u003c\/p\u003e\n\u003cp\u003eEquipped with an LED display, Ice\/Nic control, and adjustable wattage, this Adalya flavour vape reaches up to 40,000 puffs, delivering premium performance and flavor in a compact and modern design.\u003c\/p\u003e\n\u003cp\u003eKey features\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003ePremium Turkish Flavours\u003c\/li\u003e\n\u003cli\u003eUp to 40,000 puffs\u003cbr\u003e\n\u003c\/li\u003e\n\u003cli\u003eDigital LED display with power control\u003cbr\u003e\n\u003c\/li\u003e\n\u003cli\u003eAdjusting ICE and nicotine levels\u003cbr\u003e\n\u003c\/li\u003e\n\u003cli\u003eUSB-C charging port\u003cbr\u003e\n\u003c\/li\u003e\n\u003cli\u003eLiquid capacity: approx. 25 ml\u003cbr\u003e\n\u003c\/li\u003e\n\u003cli\u003e850mAh rechargeable battery\u003cbr\u003e\n\u003c\/li\u003e\n\u003cli\u003eMesh coil for greater purity and flavor intensity\u003cbr\u003e\n\u003c\/li\u003e\n\u003cli\u003eGerman manufacturing with high quality standards\u003c\/li\u003e\n\u003c\/ul\u003e","brand":"IGET","offers":[{"title":"Blue melon","offer_id":42030462009399,"sku":"Adalya AD40K (40K P) - Blue Melon","price":2650.0,"currency_code":"KES","in_stock":true},{"title":"Lady Killer","offer_id":42030465941559,"sku":"Adalya AD40K (40K P) - Lady Killer","price":2650.0,"currency_code":"KES","in_stock":true},{"title":"Love66","offer_id":42030465974327,"sku":"Adalya AD40K (40K P) - Love 66","price":2650.0,"currency_code":"KES","in_stock":true},{"title":"Punkman","offer_id":42030466039863,"sku":"Adalya AD40K (40K P) - Punkman","price":2650.0,"currency_code":"KES","in_stock":true},{"title":"Very Berry","offer_id":42030466105399,"sku":"Adalya AD40K (40K P) - Verry Berry","price":2650.0,"currency_code":"KES","in_stock":true},{"title":"Peach Ice","offer_id":42030466138167,"sku":"Adalya AD40K (40K P) - Peach Ice","price":2650.0,"currency_code":"KES","in_stock":true},{"title":"Double Melon Ice","offer_id":42030466170935,"sku":"Adalya AD40K (40K P) - Double Melon Ice","price":2650.0,"currency_code":"KES","in_stock":true},{"title":"Havana","offer_id":42030466203703,"sku":"Adalya AD40K (40K P) - Havana","price":2650.0,"currency_code":"KES","in_stock":true},{"title":"Hawaii","offer_id":42030466236471,"sku":"Adalya AD40K (40K P) - Hawaii","price":2650.0,"currency_code":"KES","in_stock":true},{"title":"Two Apples","offer_id":42030466269239,"sku":"Adalya AD40K (40K P) - Two Apples","price":2650.0,"currency_code":"KES","in_stock":true},{"title":"Watermelon Ice","offer_id":42030466302007,"sku":"Adalya AD40K (40K P) - Watermelon Ice","price":2650.0,"currency_code":"KES","in_stock":false},{"title":"Apple Peach","offer_id":42030459879479,"sku":"Adalya AD40K (40K P) - Apple Peach","price":2650.0,"currency_code":"KES","in_stock":false},{"title":"Fresh Lime","offer_id":42030465908791,"sku":"Adalya AD40K (40K P) - Fresh Lime","price":2650.0,"currency_code":"KES","in_stock":false},{"title":"Cola Dragon","offer_id":42030465876023,"sku":"Adalya AD40K (40K P) - Cola Dragon","price":2650.0,"currency_code":"KES","in_stock":false},{"title":"Mintpoint","offer_id":42030466007095,"sku":"Adalya AD40K (40K P) - Mintpoint","price":2650.0,"currency_code":"KES","in_stock":false},{"title":"Sweet Custard Tobacco","offer_id":42030466072631,"sku":"Adalya AD40K (40K P) - Sweet Custard Tobacco","price":2650.0,"currency_code":"KES","in_stock":false}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/adalya-40K-apple-peach-hypermax-vape.webp?v=1766456707"},{"product_id":"elfbar-trio-40000-puffs","title":"Elfbar Trio (40000 Puffs)","description":"\u003cp\u003eMeet the Elf Bar Trio 40K — a next-gen premium disposable vape built for vapers who want control, flavor, and serious longevity. Delivering up to 40,000 puffs, this device features an exclusive three-mode flavor system that lets you switch between Sweet, Icy, and Sour profiles anytime. One device, three vibes.\u003c\/p\u003e\n\u003cp\u003eWith a simple switch, you can change the intensity and flavor experience in seconds—perfect for all-day use without juggling multiple pods. Whether you’re craving smooth sweetness, an icy kick, or a tangy punch, the Trio 40K adapts to your mood instantly, now shop elfbar at best price in Kenya from [YOUR BRAND]!\u003c\/p\u003e\n\u003cp\u003eWhy Choose \u003ca href=\"https:\/\/[YOUR DOMAIN]\/collections\/elfbar-vapes\" title=\"Elfbar\"\u003eElfbar\u003c\/a\u003e Trio 40K?\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003eUp to 40,000 real puffs with consistent output\u003c\/li\u003e\n\u003cli\u003e3 flavor modes: Sweet, Icy \u0026amp; Sour\u003c\/li\u003e\n\u003cli\u003eInstant flavor control with easy switching\u003c\/li\u003e\n\u003cli\u003eMulti-coil technology for even heating\u003c\/li\u003e\n\u003cli\u003ePowerful 850mAh rechargeable battery\u003c\/li\u003e\n\u003cli\u003eUSB-C fast charging\u003c\/li\u003e\n\u003cli\u003eRich vapor \u0026amp; authentic flavor till the last puff\u003c\/li\u003e\n\u003c\/ul\u003e","brand":"ELF BAR","offers":[{"title":"Blue Razz Ice","offer_id":42085045829687,"sku":"E B Trio (40K P) - Blue Razz Ice","price":2800.0,"currency_code":"KES","in_stock":true},{"title":"Grape Ice","offer_id":42085083217975,"sku":"E B Trio (40K P) - Grape Ice","price":2800.0,"currency_code":"KES","in_stock":true},{"title":"Blueberry Raspberry Ice","offer_id":42085083250743,"sku":"E B Trio (40K P) - Blueberry Raspberry Ice","price":2800.0,"currency_code":"KES","in_stock":true},{"title":"Peach Ice","offer_id":42089075834935,"sku":"E B Trio (40K P) - Peach Ice","price":2800.0,"currency_code":"KES","in_stock":true},{"title":"Double Mango","offer_id":42085095669815,"sku":"E B Trio (40K P) - Double Mango","price":2800.0,"currency_code":"KES","in_stock":true},{"title":"Mix Berry","offer_id":42085095735351,"sku":"E B Trio (40K P) - Mix Berry","price":2800.0,"currency_code":"KES","in_stock":true},{"title":"Peach Mango","offer_id":42085095768119,"sku":"E B Trio (40K P) - Peach Mango","price":2800.0,"currency_code":"KES","in_stock":true},{"title":"VCT","offer_id":42085095800887,"sku":"E B Trio (40K P) - VCT","price":2800.0,"currency_code":"KES","in_stock":true},{"title":"Blueberry Ice","offer_id":42085095833655,"sku":"E B Trio (40K P) - Blueberry Ice","price":2800.0,"currency_code":"KES","in_stock":true},{"title":"Strawberry Mango","offer_id":42085095931959,"sku":"E B Trio (40K P) - Strawberry Mango","price":2800.0,"currency_code":"KES","in_stock":true},{"title":"Strawberry Kiwi","offer_id":42085095964727,"sku":"E B Trio (40K P) - Strawberry Kiwi","price":2800.0,"currency_code":"KES","in_stock":true},{"title":"Strawberry Ice","offer_id":42085095997495,"sku":"E B Trio (40K P) - Strawberry Ice","price":2800.0,"currency_code":"KES","in_stock":true},{"title":"Strawberry Watermelon","offer_id":420850