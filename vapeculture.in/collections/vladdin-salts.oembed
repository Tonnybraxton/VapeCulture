003c\/a\u003e with a blend of tropical fruits and a distinctive, all-natural flavor is now available in 30mg strengths. Enjoy a variety of flavors all at once.\u003c\/p\u003e\n\u003cp\u003eFeatures:\u003cbr\u003e\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003eNicotine Strength: 30mg \u0026amp; 50mg\u003cbr\u003e\n\u003c\/li\u003e\n\u003cli\u003ePG\/VG: 50\/50\u003c\/li\u003e\n\u003cli\u003eBottle Size: 30ml Chubby Gorilla Bottle\u003c\/li\u003e\n\u003c\/ul\u003e","brand":"Vladdin","offers":[{"title":"30mg","offer_id":41774705639479,"sku":"Vladdin Peach Mango 30 Mg","price":1490.0,"currency_code":"KES","in_stock":false},{"title":"50mg","offer_id":41774705672247,"sku":"Vladdin Peach Mango 50 mg","price":1490.0,"currency_code":"KES","in_stock":false}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/vladdin-mango-peach-nic-salts.jpg?v=1752483988"},{"product_id":"vladdin-nic-salt-strawberry-kiwi","title":"Vladdin Nic Salt - Strawberry Kiwi","description":"\u003cp\u003eVapers who adore the Salt Nic Pod System are likely familiar with Vladdin Strawberry Kiwi NicSalt E-Liquids 30ml. Vladdin’s Strawberry Kiwi flavor is the greatest scrumptious combination of juicy strawberries and Kiwis.\u003c\/p\u003e\n\u003cp\u003eA range of salt nicotine essential oils by Vladdin with a blend of tropical fruits and a distinctive, all-natural flavor is now available in 30mg strengths. Enjoy a variety of flavors all at once.\u003c\/p\u003e\n\u003cp\u003eFeatures:\u003cbr\u003e\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003eNicotine Strength: 30mg \u0026amp; 50mg\u003cbr\u003e\n\u003c\/li\u003e\n\u003cli\u003ePG\/VG: 50\/50\u003c\/li\u003e\n\u003cli\u003eBottle Size: 30ml Chubby Gorilla Bottle\u003c\/li\u003e\n\u003c\/ul\u003e","brand":"Vladdin","offers":[{"title":"30mg","offer_id":41774705705015,"sku":"Vladdin Strawberry Kiwi 30 Mg","price":1490.0,"currency_code":"KES","in_stock":false},{"title":"50mg","offer_id":41774705737783,"sku":"Vladdin Strawberry Kiwi 50 Mg","price":1490.0,"currency_code":"KES","in_stock":false}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/vladdin-strawberry-kiwi-nic-salts.jpg?v=1752483991"},{"product_id":"vladdin-nic-salt-gummy-bear","title":"Vladdin Nic Salt - Gummy Bear","description":"\u003cdiv\u003e\u003cspan\u003eIndulge your sweet tooth with the fruity goodness of Gummy Bear. This playful flavor captures the nostalgic taste of your favorite gummy candies, offering a sweet and satisfying vaping experience. Each inhale is like biting into a handful of chewy gummy bears, with its vibrant flavor enveloping your palate and leaving you craving more.\u003c\/span\u003e\u003c\/div\u003e\n\u003cdiv\u003e\n\u003cspan style=\"font-size: 0.875rem;\"\u003e\u003c\/span\u003e\u003cbr\u003e\n\u003c\/div\u003e\n\u003cp\u003eFeatures:\u003cbr\u003e\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003eNicotine Strength: 30mg \u0026amp; 50mg\u003c\/li\u003e\n\u003cli\u003eBrand: \u003ca href=\"https:\/\/[YOUR DOMAIN]\/collections\/vladdin-salts\" title=\"Vladdin Nic Salt\"\u003eVladdin\u003c\/a\u003e\n\u003c\/li\u003e\n\u003cli\u003ePG\/VG: 50\/50\u003c\/li\u003e\n\u003cli\u003eBottle Size: 30ml Chubby Gorilla Bottle\u003c\/li\u003e\n\u003c\/ul\u003e","brand":"Vladdin","offers":[{"title":"30mg","offer_id":41774706163767,"sku":"Vladdin Gummy Bear 30 Mg","price":1490.0,"currency_code":"KES","in_stock":true},{"title":"50mg","offer_id":41774706196535,"sku":"Vladdin Gummy Bear 50 Mg","price":1490.0,"currency_code":"KES","in_stock":true}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/Vladdin-Gummy-Bear-Nic-Salt-30ml-min.jpg?v=1752483993"},{"product_id":"vladdin-nic-salt-honeydew-ice","title":"Vladdin Nic Salt - Honeydew Ice","description":"\u003cdiv\u003e\n\u003cstrong\u003eHoneydew Ice:\u003c\/strong\u003e\u003cspan\u003e Cool off with the icy sweetness of Honeydew Ice. This refreshing flavor combines the juicy sweetness of ripe honeydew melon with a hint of menthol, offering a crisp and invigorating vaping experience. Each inhale is like biting into a chilled slice of honeydew, with its coolness enveloping your palate and leaving you feeling utterly satisfied. It's the perfect choice for vapers seeking a refreshing vape experience that's both sweet and cooling.\u003c\/span\u003e\n\u003c\/div\u003e\n\u003cdiv\u003e\n\u003cspan style=\"font-size: 0.875rem;\"\u003e\u003c\/span\u003e\u003cbr\u003e\n\u003c\/div\u003e\n\u003cp\u003eFeatures:\u003cbr\u003e\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003eNicotine Strength: 30mg \u0026amp; 50mg\u003c\/li\u003e\n\u003cli\u003ePG\/VG: 50\/50\u003c\/li\u003e\n\u003cli\u003eBottle Size: 30ml Chubby Gorilla Bottle\u003c\/li\u003e\n\u003c\/ul\u003e","brand":"Vladdin","offers":[{"title":"30mg","offer_id":41774706229303,"sku":"Vladdin Honeydew Ice 30 mg","price":1490.0,"currency_code":"KES","in_stock":true},{"title":"50mg","offer_id":41774706262071,"sku":"Vladdin Honeydew Ice 50 mg","price":1490.0,"currency_code":"KES","in_stock":false}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/Vladdin-Honeydew-Ice-Nic-Salt-30ml-min.jpg?v=1752483995"},{"product_id":"vladdin-nic-salt-fresh-lychee","title":"Vladdin Nic Salt - Fresh Lychee","description":"\u003cdiv\u003e\n\u003cstrong\u003eFresh Lychee:\u003c\/strong\u003e\u003cspan\u003e Delight in the exotic allure of Fresh Lychee. This unique flavor captures the sweet and floral taste of ripe lychees, offering a refreshing and invigorating vaping experience. Each inhale is like biting into a juicy lychee, with its distinctive flavor tantalizing your taste buds and leaving you craving more. It's the perfect choice for vapers seeking an exotic vape experience that's as satisfying as it is delicious.\u003c\/span\u003e\n\u003c\/div\u003e\n\u003cdiv\u003e\n\u003cspan style=\"font-size: 0.875rem;\"\u003e\u003c\/span\u003e\u003cbr\u003e\n\u003c\/div\u003e\n\u003cp\u003eFeatures:\u003cbr\u003e\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003eNicotine Strength: 30mg \u0026amp; 50mg\u003c\/li\u003e\n\u003cli\u003ePG\/VG: 50\/50\u003c\/li\u003e\n\u003cli\u003eBottle Size: 30ml Chubby Gorilla Bottle\u003c\/li\u003e\n\u003c\/ul\u003e","brand":"Vladdin","offers":[{"title":"30mg","offer_id":41774706294839,"sku":"Vladdin Fresh Lychee 30 Mg","price":1490.0,"currency_code":"KES","in_stock":false},{"title":"50mg","offer_id":41774706327607,"sku":"Vladdin Fresh Lychee 50 Mg","price":1490.0,"currency_code":"KES","in_stock":false}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/Vladdin-Fresh-Lychee-Nic-Salt-30ml-min.jpg?v=1752483998"},{"product_id":"vladdin-nic-salt-mixed-berry","title":"Vladdin Nic Salt - Mixed Berry","description":"\u003cdiv\u003e\n\u003cstrong\u003eMixed Berry:\u003c\/strong\u003e\u003cspan\u003e Indulge in a medley of fruity goodness with Mixed Berries. This delightful blend combines the sweet and tart flavors of assorted berries, offering a burst of freshness with every puff. Each inhale is like biting into a handful of ripe berries, with its vibrant flavor tantalizing your taste buds and leaving you craving more. It's the perfect choice for vapers seeking a fruity vape experience that's as satisfying as it is delicious.\u003c\/span\u003e\n\u003c\/div\u003e\n\u003cdiv\u003e\n\u003cspan style=\"font-size: 0.875rem;\"\u003e\u003c\/span\u003e\u003cbr\u003e\n\u003c\/div\u003e\n\u003cp\u003eFeatures:\u003cbr\u003e\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003eNicotine Strength: 30mg \u0026amp; 50mg\u003c\/li\u003e\n\u003cli\u003ePG\/VG: 50\/50\u003c\/li\u003e\n\u003cli\u003eBottle Size: 30ml Chubby Gorilla Bottle\u003c\/li\u003e\n\u003c\/ul\u003e","brand":"Vladdin","offers":[{"title":"30mg","offer_id":41774706360375,"sku":"Vladdin Mixed Berry 30 Mg","price":1490.0,"currency_code":"KES","in_stock":true},{"title":"50mg","offer_id":41774706393143,"sku":"Vladdin Mixed Berry 50 Mg","price":1490.0,"currency_code":"KES","in_stock":true}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/Vladdin-mix-berry-salt-30ml-min.jpg?v=1752484000"},{"product_id":"vladdin-nic-salt-aloe-grape","title":"Vladdin Nic Salt - Aloe Grape","description":"\u003cdiv\u003e\n\u003cstrong\u003eAloe Grape:\u003c\/strong\u003e\u003cspan\u003e Transport yourself to a verdant vineyard oasis with Aloe Grape. This unique fusion blends the soothing essence of aloe vera with the luscious sweetness of ripe grapes, creating a vape experience that's both refreshing and invigorating. Each inhale bathes your palate in a cool wave of aloe-infused grape goodness, leaving you feeling rejuvenated and satisfied. It's a harmonious dance of floral and fruity notes that tantalizes the taste buds and transports you to a world of natural bliss.\u003c\/span\u003e\n\u003c\/div\u003e\n\u003cdiv\u003e\n\u003cspan style=\"font-size: 0.875rem;\"\u003e\u003c\/span\u003e\u003cbr\u003e\n\u003c\/div\u003e\n\u003cp\u003eFeatures:\u003cbr\u003e\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003eNicotine Strength: 30mg \u0026amp; 50mg\u003c\/li\u003e\n\u003cli\u003ePG\/VG: 50\/50\u003c\/li\u003e\n\u003cli\u003eBottle Size: 30ml Chubby Gorilla Bottle\u003c\/li\u003e\n\u003c\/ul\u003e","brand":"Vladdin","offers":[{"title":"30mg","offer_id":41774706425911,"sku":"Vladdin Aloe Grape 30 Mg","price":1490.0,"currency_code":"KES","in_stock":false},{"title":"50mg","offer_id":41774706458679,"sku":"Vladdin Aloe Grape 50 Mg","price":1490.0,"currency_code":"KES","in_stock":false}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/Vladdin-aloe-grape-nic-salt-30ml-min.jpg?v=1752484002"},{"product_id":"vladdin-nic-salt-grape-peach","title":"Vladdin Nic Salt - Grape Peach","description":"\u003cdiv\u003e\n\u003cstrong\u003eGrape Peach:\u003c\/strong\u003e\u003cspan\u003e Delight in the perfect harmony of Grape Peach. This tantalizing blend combines the succulent sweetness of ripe peaches with the bold, fruity notes of grapes, offering a symphony of flavor with every inhale. Each puff is like sipping on a refreshing fruit cocktail, with its juicy goodness enveloping your palate and leaving you feeling utterly satisfied. \u003c\/span\u003e\n\u003c\/div\u003e\n\u003cdiv\u003e\n\u003cspan style=\"font-size: 0.875rem;\"\u003e\u003c\/span\u003e\u003cbr\u003e\n\u003c\/div\u003e\n\u003cp\u003eFeatures:\u003cbr\u003e\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003eNicotine Strength: 30mg \u0026amp; 50mg\u003c\/li\u003e\n\u003cli\u003ePG\/VG: 50\/50\u003c\/li\u003e\n\u003cli\u003eBottle Size: 30ml Chubby Gorilla Bottle\u003c\/li\u003e\n\u003c\/ul\u003e","brand":"Vladdin","offers":[{"title":"30mg","offer_id":41774706491447,"sku":"Vladdin Grape Peach 30 Mg","price":1490.0,"currency_code":"KES","in_stock":true},{"title":"50mg","offer_id":41774706524215,"sku":"Vladdin Grape Peach 50 mg","price":1490.0,"currency_code":"KES","in_stock":true}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/vladdin-Grape-peach-nic-salt-30ml-min.jpg?v=1752484004"},{"product_id":"vladdin-nic-salt-green-mango","title":"Vladdin Nic Salt - Green Mango","description":"\u003cdiv\u003e\n\u003cstrong\u003eGreen Mango:\u003c\/strong\u003e\u003cspan\u003e Embark on a tropical escapade with Green Mango. This exotic flavor combines the tangy sweetness of unripe mangoes with a hint sour lime, offering a refreshing and invigorating vaping experience. Each inhale is like biting into a juicy mango, with its vibrant flavor tantalizing your taste buds and leaving you craving more.\u003c\/span\u003e\n\u003c\/div\u003e\n\u003cdiv\u003e\n\u003cspan style=\"font-size: 0.875rem;\"\u003e\u003c\/span\u003e\u003cbr\u003e\n\u003c\/div\u003e\n\u003cp\u003eFeatures:\u003cbr\u003e\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003ca href=\"https:\/\/[YOUR DOMAIN]\/collections\/nic-salts\" title=\"Nicotine Salt\"\u003eNicotine Salt\u003c\/a\u003e Strength: 30mg \u0026amp; 50mg\u003c\/li\u003e\n\u003cli\u003ePG\/VG: 50\/50\u003c\/li\u003e\n\u003cli\u003eBottle Size: 30ml Chubby Gorilla Bottle\u003c\/li\u003e\n\u003c\/ul\u003e","brand":"Vladdin","offers":[{"title":"30mg","offer_id":41774706556983,"sku":"Vladdin Green Mango 30 Mg","price":1490.0,"currency_code":"KES","in_stock":true},{"title":"50mg","offer_id":41774706589751,"sku":"Vladdin Green Mango 50 Mg","price":1490.0,"currency_code":"KES","in_stock":true}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/Vladdin-Green-Mango-Nic-Salt-30ml-min.jpg?v=1752484007"},{"product_id":"vladdin-nic-salt-green-apple","title":"Vladdin Nic Salt - Green Apple","description":"\u003cdiv\u003e\n\u003cstrong\u003eGreen Apple:\u003c\/strong\u003e\u003cspan\u003e Crisp, tangy, and irresistibly fresh, Green Apple delivers the quintessential taste of biting into a perfectly ripe Granny Smith. Each puff floods the palate with the tartness of green apples, while subtle undertones of sweetness linger on the exhale. It's a flavor that captures the essence of a crisp autumn day, offering a refreshing vaping experience that's both familiar and delightful.\u003c\/span\u003e\n\u003c\/div\u003e\n\u003cdiv\u003e\n\u003cspan style=\"font-size: 0.875rem;\"\u003e\u003c\/span\u003e\u003cbr\u003e\n\u003c\/div\u003e\n\u003cp\u003eFeatures:\u003cbr\u003e\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003eNicotine Strength: 30mg \u0026amp; 50mg\u003c\/li\u003e\n\u003cli\u003eBrand: \u003ca href=\"https:\/\/[YOUR DOMAIN]\/collections\/vladdin-salts\" title=\"Vladdin nic salts\"\u003eVladdin\u003c\/a\u003e\n\u003c\/li\u003e\n\u003cli\u003ePG\/VG: 50\/50\u003c\/li\u003e\n\u003cli\u003eBottle Size: 30ml Chubby Gorilla Bottle\u003c\/li\u003e\n\u003c\/ul\u003e","brand":"Vladdin","offers":[{"title":"30mg","offer_id":41774706622519,"sku":"Vladdin Green Apple 30 Mg","price":1490.0,"currency_code":"KES","in_stock":false},{"title":"50mg","offer_id":41774706655287,"sku":"Vladdin Green Apple 50 Mg","price":1490.0,"currency_code":"KES","in_stock":false}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/059