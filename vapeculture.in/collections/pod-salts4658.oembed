03c\/ul\u003e\n\u003cp\u003eFor the best Pod nic salt experience, we recommend MTL style vaping, and any low-wattage device using 10-20 watts with medium to tight draw, 0.8-1.2ohm resistance.\u003c\/p\u003e","brand":"POD SALT","offers":[{"title":"25mg\/ml ( 2.5% Nicotine )","offer_id":41806980218935,"sku":"POD S - Strawberry Marshmallow - 20 mg","price":1599.0,"currency_code":"KES","in_stock":false},{"title":"50mg\/ml ( 5% Nicotine )","offer_id":41806980251703,"sku":"POD S - Strawberry Marshmallow - 50 mg","price":1599.0,"currency_code":"KES","in_stock":true}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/pod-salt-marshmallow-strawberry-marshmallow-salts-30ml.webp?v=1754245514"},{"product_id":"pod-salt-grape","title":"POD SALT - Grape","description":"\u003cp\u003eA tangy delight that’s fresh and bursting with juicy notes, Grape Ice Core Nic Salts vape juice is a fun and fruity flavour you can enjoy all day. Fragrant, mouth-watering grapes blend with chilling ice.\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003eBottle size: 30ml\u003c\/li\u003e\n\u003cli\u003eNicotine Strength: 25mg\u003c\/li\u003e\n\u003cli\u003eRatio: 50VG\/50PG\u003c\/li\u003e\n\u003cli\u003eMade in the UK\u003c\/li\u003e\n\u003cli\u003eTPD Compliant\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp\u003eFor the best Pod nic salt experience, we recommend MTL style vaping, and any low-wattage device using 10-20 watts with medium to tight draw, 0.8-1.2ohm resistance. Have a look at our \u003ca href=\"https:\/\/www.[YOUR DOMAIN]\/\" title=\"latest vape\"\u003elatest vape\u003c\/a\u003e collection.\u003c\/p\u003e","brand":"POD SALT","offers":[{"title":"25mg\/ml ( 2.5% Nicotine )","offer_id":41915025162295,"sku":"POD S - Grape - 25 mg","price":1599.0,"currency_code":"KES","in_stock":false},{"title":"50mg\/ml ( 5% Nicotine )","offer_id":41915025195063,"sku":"POD S - Grape - 50 mg","price":1599.0,"currency_code":"KES","in_stock":false},{"title":"20mg\/ml ( 2% Nicotine )","offer_id":41916196716599,"sku":"POD S - Grape - 20 mg","price":1599.0,"currency_code":"KES","in_stock":false}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/Pod-Salt-NicSalt-Core-Grape.webp?v=1759879900"},{"product_id":"pod-salt-pear-apple-raspberry","title":"POD SALT - Pear Apple Raspberry","description":"\u003cp\u003ePod Salt Nexus Pear Apple Raspberry captures the essence of a classic British garden in every puff. Mellow pears, crisp apples, and sweet raspberries combine for a fresh and fruity blend. A subtle hint of tartness adds the perfect finishing touch to this vibrant and flavorful \u003ca href=\"https:\/\/www.[YOUR DOMAIN]\" title=\"Vape\"\u003evape\u003c\/a\u003e.\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003eBottle size: 30ml\u003c\/li\u003e\n\u003cli\u003eNicotine Strength: 25mg\u003c\/li\u003e\n\u003cli\u003eRatio: 50VG\/50PG\u003c\/li\u003e\n\u003cli\u003eMade in the UK\u003c\/li\u003e\n\u003cli\u003eTPD Compliant\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp\u003eFor the best Pod nic salt experience, we recommend MTL style vaping, and any low-wattage device using 10-20 watts with medium to tight draw, 0.8-1.2ohm resistance. \u003c\/p\u003e","brand":"POD SALT","offers":[{"title":"25mg\/ml ( 2.5% Nicotine )","offer_id":41915030011959,"sku":"POD S - Pear Apple Raspberry -  25 mg","price":1599.0,"currency_code":"KES","in_stock":false},{"title":"50mg\/ml ( 5% Nicotine )","offer_id":41915030044727,"sku":"POD S - Pear Apple Raspberry -  50 mg","price":1599.0,"currency_code":"KES","in_stock":false},{"title":"20mg\/ml ( 2% Nicotine )","offer_id":41916186460215,"sku":"POD S - Pear Apple Raspberry -  20 mg","price":1599.0,"currency_code":"KES","in_stock":true}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/pod_salt_pear_apple_raspberry_salt_f8425c11-bb1d-447d-ac8c-507453bd93e6.webp?v=1759880216"},{"product_id":"pod-salt-blueberry-pomegranate","title":"POD SALT - Blueberry Pomegranate","description":"\u003cp\u003eBlueberry Pomegranate by Pod Salt Core is fuses tart notes of blueberry with a delicate sweetness of pomegranate. A rich blueberry inhale is joined with slight exotic notes of pomegranate.\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003eBottle size: 30ml\u003c\/li\u003e\n\u003cli\u003eNicotine Strength: 25mg\u003c\/li\u003e\n\u003cli\u003eRatio: 50VG\/50PG\u003c\/li\u003e\n\u003cli\u003eMade in the UK\u003c\/li\u003e\n\u003cli\u003eTPD Compliant\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp\u003eFor the best Pod nic salt experience, we recommend MTL style vaping, and any low-wattage device using 10-20 watts with medium to tight draw, 0.8-1.2ohm resistance. \u003c\/p\u003e","brand":"POD SALT","offers":[{"title":"25mg\/ml ( 2.5% Nicotine )","offer_id":41915030831159,"sku":"POD S - Blueberry Pomegranate - 25 mg","price":1599.0,"currency_code":"KES","in_stock":false},{"title":"50mg\/ml ( 5% Nicotine )","offer_id":41915030863927,"sku":"POD S - Blueberry Pomegranate - 50 mg","price":1599.0,"currency_code":"KES","in_stock":false},{"title":"20mg\/ml ( 2.0% Nicotine )","offer_id":41916155723831,"sku":"POD S - Blueberry Pomegranate - 20 mg","price":1599.0,"currency_code":"KES","in_stock":true}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/Blueberry_Pomegranate_Nic_Salt_E-Liquid_by_Pod_Salt.webp?v=1759879899"},{"product_id":"pod-salt-freebase-mango-ice","title":"Pod Salt Freebase - Mango Ice","description":"\u003cp\u003ePod Salt Freebase Mango Ice Cream 60ml offers a luxurious blend of juicy mangoes and creamy ice cream with a refreshing icy twist. This premium freebase e-liquid delivers smooth vapor, rich dessert flavor, and a cool finish. Available in 3mg and 6mg nicotine strengths, it ensures a satisfying throat hit in a durable Gorilla bottle for all-day vaping enjoyment.\u003c\/p\u003e\n\u003cp\u003eFeatures:\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003eFlavour Profile: Tropical Mango with Creamy Ice Cream \u0026amp; Ice\u003c\/li\u003e\n\u003cli\u003eBottle Size: 60ml Gorilla Bottle\u003c\/li\u003e\n\u003cli\u003eNicotine Strengths: 3mg \u0026amp; 6mg\u003c\/li\u003e\n\u003cli\u003eFreebase Formula: Rich flavor with a smooth throat hit\u003c\/li\u003e\n\u003cli\u003eExperience: Dessert-style vape with icy refreshment\u003c\/li\u003e\n\u003c\/ul\u003e","brand":"POD SALT","offers":[{"title":"3MG","offer_id":41991045316663,"sku":"Pod S - Mango Ice - 3 MG","price":1699.0,"currency_code":"KES","in_stock":false},{"title":"6MG","offer_id":41991046889527,"sku":"Pod S - Mango Ice - 6 MG","price":1699.0,"currency_code":"KES","in_stock":true}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/pod-salt-freebase-eliquid-mango-ice.webp?v=1763436015"},{"product_id":"pod-salt-freebase-strawberry-kiwi-ice","title":"Pod Salt Freebase - Strawberry Kiwi Ice","description":"\u003cp\u003eExperience the refreshing blend of ripe strawberries and tangy kiwi with Pod Salt Freebase Strawberry Kiwi Ice. This 60ml e-liquid delivers a fruity burst followed by a cool icy exhale, perfect for vapers who enjoy balanced sweetness with menthol freshness. Available in 3mg and 6mg nicotine strengths, the Gorilla bottle ensures easy refilling and leak-free vaping for all-day enjoyment.\u003c\/p\u003e\n\u003cp\u003eFeatures:\u003cbr\u003e\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003eFlavour Profile: Strawberry \u0026amp; Kiwi with Ice\u003c\/li\u003e\n\u003cli\u003eBottle Size: 60ml Gorilla Bottle\u003c\/li\u003e\n\u003cli\u003eNicotine Strengths: 3mg \u0026amp; 6mg\u003c\/li\u003e\n\u003cli\u003eFreebase Formula: Perfect for cloud production and smooth hit\u003c\/li\u003e\n\u003c\/ul\u003e","brand":"POD SALT","offers":[{"title":"3MG","offer_id":41991053246519,"sku":"Pod S - Strawberry Kiwi Ice - 3 MG","price":1699.0,"currency_code":"KES","in_stock":true},{"title":"6MG","offer_id":41991053279287,"sku":"Pod S - Strawberry Kiwi Ice - 6 MG","price":1699.0,"currency_code":"KES","in_stock":true}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/pod-salt-freebase-eliquid-strawberry-kiwi-ice.webp?v=1763436285"},{"product_id":"pod-salt-freebase-grape","title":"Pod Salt Freebase - Grape","description":"\u003cp\u003eExperience the bold, juicy taste of ripe grapes with Pod Salt Freebase Grape. This premium 60ml e-liquid offers a naturally sweet grape flavor with smooth throat hit and dense vapor production. Available in 3mg and 6mg nicotine strengths, the Gorilla bottle ensures easy refilling and a mess-free vaping experience, perfect for everyday use.\u003c\/p\u003e\n\u003cp\u003eFeatures:\u003cbr\u003e\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003eFlavour Profile: Sweet and juicy grape\u003c\/li\u003e\n\u003cli\u003eBottle Size: 60ml Gorilla Bottle\u003c\/li\u003e\n\u003cli\u003eNicotine Strengths: 3mg \u0026amp; 6mg\u003c\/li\u003e\n\u003cli\u003eFreebase Formula: Designed for rich flavor and cloud production\u003c\/li\u003e\n\u003c\/ul\u003e","brand":"POD SALT","offers":[{"title":"3MG","offer_id":41991054164023,"sku":"Pod S - Grape - 3 MG","price":1699.0,"currency_code":"KES","in_stock":true},{"title":"6MG","offer_id":41991054196791,"sku":"Pod S - Grape - 6 MG","price":1699.0,"currency_code":"KES","in_stock":true}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/pod-salt-freebase-eliquid-grape.webp?v=1763436416"},{"product_id":"pod-salt-freebase-spearmint","title":"Pod Salt Freebase - Spearmint","description":"\u003cp\u003eEnjoy the perfect balance of freshness and smoothness with Pod Salt Freebase Spearmint. This premium 60ml e-liquid delivers a clean, minty flavor that refreshes your senses with every puff. Available in 3mg and 6mg nicotine strengths, it provides a silky inhale and cool exhale. The Gorilla bottle ensures easy handling and a leak-proof vaping experience.\u003c\/p\u003e\n\u003cp\u003eFeatures:\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003eFlavour Profile: Refreshing Spearmint\u003c\/li\u003e\n\u003cli\u003eBottle Size: 60ml Gorilla Bottle (leak-resistant)\u003c\/li\u003e\n\u003cli\u003eNicotine Strengths: 3mg \u0026amp; 6mg options\u003c\/li\u003e\n\u003cli\u003eFreebase Formula: Smooth throat hit with rich vapor\u003cbr\u003e\n\u003c\/li\u003e\n\u003c\/ul\u003e","brand":"POD SALT","offers":[{"title":"3MG","offer_id":41991055081527,"sku":"Pod S - Spearmint - 3 MG","price":1699.0,"currency_code":"KES","in_stock":false},{"title":"6MG","offer_id":41991055114295,"sku":"Pod S - Spearmint - 6 MG","price":1699.0,"currency_code":"KES","in_stock":true}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/pod-salt-freebase-eliquid-spearmint.webp?v=1763436560"}],"url":"https:\/\/[YOUR DOMAIN]\/collections\/pod-salts.oembed?page=2","provider":"[YOUR BRAND]","version":"1.0","type":"link"}




