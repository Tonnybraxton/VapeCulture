esign.\u003c\/p\u003e\n\u003cp\u003eZiip Juul Pods Features:\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003e1ml pods\u003c\/li\u003e\n\u003cli\u003e5% salt nic\u003c\/li\u003e\n\u003cli\u003ePack of four pods\u003c\/li\u003e\n\u003cli\u003eNicotine salt formula\u003c\/li\u003e\n\u003cli\u003eJUUL-compatible pods\u003c\/li\u003e\n\u003c\/ul\u003e","brand":"Juul","offers":[{"title":"Mango","offer_id":42016134692919,"sku":"Ziip (J C P) - Mango","price":1390.0,"currency_code":"KES","in_stock":false},{"title":"Iced Watermelon","offer_id":42016134660151,"sku":"Ziip (J C P) - Iced Watermelon","price":1390.0,"currency_code":"KES","in_stock":false},{"title":"Energy Drink","offer_id":41862844186679,"sku":"Ziip (J C P) - Energy Drink","price":1390.0,"currency_code":"KES","in_stock":true},{"title":"Iced Pina Colada","offer_id":41862844219447,"sku":"Ziip (J C P) - Iced Pina Colada","price":1390.0,"currency_code":"KES","in_stock":true},{"title":"Iced Blueberry","offer_id":41862844284983,"sku":"Ziip (J C P) - Iced Blueberry","price":1390.0,"currency_code":"KES","in_stock":false},{"title":"Cappuccino","offer_id":42016134594615,"sku":"Ziip (J C P) - Cappuccino","price":1390.0,"currency_code":"KES","in_stock":false},{"title":"Iced Cola","offer_id":42016134627383,"sku":"Ziip (J C P) - Iced Cola","price":1390.0,"currency_code":"KES","in_stock":false},{"title":"Peach","offer_id":42016134725687,"sku":"Ziip (J C P) - Peach","price":1390.0,"currency_code":"KES","in_stock":false},{"title":"Spearmint","offer_id":42016134758455,"sku":"Ziip (J C P) - Spearmint","price":1390.0,"currency_code":"KES","in_stock":false},{"title":"Mint","offer_id":41862844121143,"sku":"Ziip (J C P) - Mint","price":1390.0,"currency_code":"KES","in_stock":false},{"title":"Iced Apple","offer_id":41862844252215,"sku":"Ziip (J C P) - Iced Apple","price":1390.0,"currency_code":"KES","in_stock":false},{"title":"Iced Strawberry","offer_id":41862844153911,"sku":"Ziip (J C P) - Iced Strawberry","price":1390.0,"currency_code":"