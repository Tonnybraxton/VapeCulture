ludes:\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003e1 Uwell Caliburn GPP Replacement Pods\u003c\/li\u003e\n\u003c\/ul\u003e","brand":"Uwell","offers":[{"title":"0.4ohm GPP Pods","offer_id":41876300988471,"sku":"Cali GPP Replace Pods - 0.4 ohm","price":1850.0,"currency_code":"KES","in_stock":false},{"title":"0.6ohm GPP Pods","offer_id":41876301021239,"sku":"Cali GPP Replace Pods - 0.6 ohm","price":1850.0,"currency_code":"KES","in_stock":false},{"title":"0.9ohm GPP Pods","offer_id":41876302168119,"sku":"Cali GPP Replace Pods - 0.9 ohm","price":1850.0,"currency_code":"KES","in_stock":true},{"title":"1.2ohm GPP Pods","offer_id":41876302200887,"sku":"Cali GPP Replace Pods - 1.2 ohm","price":1850.0,"currency_code":"KES","in_stock":true}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/uwell_caliburn_gpp_replacement_pods_-_default.webp?v=1757898312"},{"product_id":"smok-nord-replacement-pods-cartridges","title":"Smok Nord Replacement Pods Cartridges","description":"\u003cp\u003eShop the SMOK NORD Pods (1-Pack w\/ 2 Coils or 3-Pack), a nifty design cartridge with a 3mL juice capacity, cleverly built with simple filling method to accommodate a wide range flavorful nic salt e-juice. Compatible with the SMOK NORD. Includes one empty SMOK NORD Pod cartridge with one (1) 0.6ohm Mesh Coil and one (1) 1.4ohm Regular Coil.\u003cbr\u003e\u003cbr\u003eSMOK NORD Refillable Pod Cartridge Features:\u003cbr\u003e\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003eFillable Pod System - Replaceable Cartridge\u003c\/li\u003e\n\u003cli\u003e3mL Juice Capacity\u003c\/li\u003e\n\u003cli\u003eOrganic Cotton\u003c\/li\u003e\n\u003cli\u003ePropreitary Magnetized Gold-Plated Connection\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cul\u003e\u003c\/ul\u003e","brand":"SMOK","offers":[{"title":"Default Title","offer_id":41990945013815,"sku":"Smok Nord Replace Pods Cartridges","price":1700.0,"currency_code":"KES","in_stock":true}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/smok_nord_replacement_pod_cartridges_2-min.jpg?v=1763426269"},{"product_id":"smok-nord-x-replacement-pods","title":"SMOK Nord X Replacement Pods","description":"\u003cp\u003eShop the NORD X Pods (3-Pack), Empty Pod, featuring a 6mL capacity, bottom press fit coil installation, and offers compatibility with SMOK RPM \u0026amp; RPM 2 Coils.\u003c\/p\u003e\n\u003cp\u003eCompatibility:\u003cbr\u003e\u003ca href=\"https:\/\/[YOUR DOMAIN]\/products\/smok-rpm-2-series-replacement-coils\" title=\"RPM 2 Coils\"\u003eRPM 2 Coils\u003c\/a\u003e\u003cbr\u003e\u003ca href=\"https:\/\/[YOUR DOMAIN]\/products\/smok-rpm-series-replacement-coils\" title=\"RPM Coils\"\u003eRPM Coils\u003c\/a\u003e\u003c\/p\u003e\n\u003cp\u003eSMOK NORD X Replacement Pods Features:\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003e6mL Nord X RPM \u0026amp; RPM 2 Pod Capacity\u003c\/li\u003e\n\u003cli\u003eSide Fill System - Silicone Stoppered\u003c\/li\u003e\n\u003cli\u003e0.16ohm RPM 2 Mesh Coil - rated for 25-50W\u003c\/li\u003e\n\u003cli\u003e0.4ohm RPM Mesh Coil - rated for 25W\u003c\/li\u003e\n\u003cli\u003eMagnetic Pod Connection\u003c\/li\u003e\n\u003c\/ul\u003e","brand":"SMOK","offers":[{"title":"Default Title","offer_id":42030423375927,"sku":"Smok Nord X Replace Pods","price":1940.0,"currency_code":"KES","in_stock":true}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0599\/6799\/5959\/files\/smok_nord_x_60w_pod_system_-_cartridge_front_view_1.webp?v=1766447570"},{"product_id":"smok-solus-2-replacement-pods","title":"SMOK Solus 2 Replacement Pods","description":"\u003cp\u003eShop the SMOK Solus 2 Pods (3-Pack), featuring a 2.5mL capacity, silicone stoppered bottom fill system, and is compatible with Solus 1 Replacement Pods.\u003c\/p\u003e\n\u003cp\u003ePlease note: When ordering Solus 2 Pods, you may receive Solus Replacement Pods, they are the same and will work in both Solus 1 AND 2 Pod Systems.\u003c\/p\u003e\n\u003cp\u003eCompatibility:\u003cbr\u003e\u003ca href=\"